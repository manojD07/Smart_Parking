	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Add timestamp to all requests",
					"pm.request.headers.add({",
					"  key: 'X-Request-Time',",
					"  value: new Date().toISOString()",
					"});",
					"",
					"// Auto-add authorization header if token exists",
					"const token = pm.environment.get('access_token');",
					"if (token && !pm.request.headers.has('Authorization')) {",
					"  pm.request.headers.add({",
					"    key: 'Authorization',",
					"    value: 'Bearer ' + token",
					"  });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log response time",
					"const responseTime = pm.response.responseTime;",
					"console.log('Response time:', responseTime + 'ms');",
					"",
					"// Check for common errors",
					"if (pm.response.code === 401) {",
					"  console.log('Authentication required - please login first');",
					"}",
					"",
					"if (pm.response.code === 403) {",
					"  console.log('Insufficient permissions - admin access required');",
					"}",
					"",
					"// Validate response structure for successful requests",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"  try {",
					"    const response = pm.response.json();",
					"    console.log('Request successful');",
					"  } catch (e) {",
					"    console.log('Response is not valid JSON');",
					"  }",
					"}"
				]
			}
