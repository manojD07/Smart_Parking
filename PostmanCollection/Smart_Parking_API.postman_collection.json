{
	"info": {
		"_postman_id": "smart-parking-api-collection",
		"name": "Smart Parking Management System API",
		"description": "Complete API collection for the Smart Parking Management System. This collection includes all endpoints for user management, authentication, parking lot operations, booking management, and administration.\n\n## Authentication\nMost endpoints require JWT authentication. Use the login endpoint first to get access tokens.\n\n## Environment Variables\n- `base_url`: API base URL (default: http://localhost:8000)\n- `access_token`: JWT access token (set automatically after login)\n- `user_id`: Current user ID\n- `booking_id`: Sample booking ID\n- `lot_id`: Sample parking lot ID",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "smart-parking-team"
	},
