{
  "name": "smart-parking-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End API Tests for Smart Parking Management System",
  "main": "index.js",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:user-journey": "jest --testNamePattern='User Journey'",
    "test:admin-journey": "jest --testNamePattern='Admin Journey'",
    "test:booking-flow": "jest --testNamePattern='Booking Flow'",
    "test:all": "jest --runInBand --verbose"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jest": "^29.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/uuid": "^9.0.7"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/setup.js"],
    "testTimeout": 30000,
    "verbose": true,
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  },
  "keywords": [
    "smart-parking",
    "api-testing",
    "e2e-testing",
    "parking-management"
  ],
  "author": "Smart Parking Team",
  "license": "MIT"
}
