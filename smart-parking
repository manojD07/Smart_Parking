#!/bin/bash

# 🅿️ Smart Parking Management System - Management Script
# This script provides easy management of the Smart Parking system using Docker Compose

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
COMPOSE_FILE="docker-compose.complete.yaml"
PROJECT_NAME="smart-parking-complete"

# Function to print colored output
print_header() {
    echo -e "\n${PURPLE}🅿️ ================================================================${NC}"
    echo -e "${PURPLE}   $1${NC}"
    echo -e "${PURPLE}================================================================${NC}\n"
}

print_status() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_step() {
    echo -e "${CYAN}🔄 $1${NC}"
}

# Check if Docker is running
check_docker() {
    print_step "Checking Docker..."
    
    if ! docker info > /dev/null 2>&1; then
        print_error "Docker is not running. Please start Docker first."
        exit 1
    fi
    
    if ! docker-compose --version > /dev/null 2>&1; then
        print_error "Docker Compose is not installed or not in PATH."
        exit 1
    fi
    
    print_status "Docker is ready"
}

# Check if images exist
check_images() {
    print_step "Checking required images..."
    
    local missing_images=()
    
    if ! docker image inspect smart-parking-backend:latest > /dev/null 2>&1; then
        missing_images+=("smart-parking-backend:latest")
    fi
    
    if ! docker image inspect smart-parking-frontend:latest > /dev/null 2>&1; then
        missing_images+=("smart-parking-frontend:latest")
    fi
    
    if [ ${#missing_images[@]} -gt 0 ]; then
        print_warning "Missing required images: ${missing_images[*]}"
        print_info "Run 'make build' or 'make docker-image' to build the images first."
        exit 1
    fi
    
    print_status "All required images are available"
}

# Start the system
start_system() {
    print_header "STARTING SMART PARKING SYSTEM"
    
    # Prerequisites
    check_docker
    check_images
    
    # Clean up any existing containers
    print_step "Cleaning up existing containers..."
    docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME down --remove-orphans > /dev/null 2>&1 || true
    
    # Start services
    print_step "Starting all services..."
    print_info "This may take a few minutes..."
    
    docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME up -d
    
    print_status "All services are starting..."
    
    # Wait for services to be ready
    wait_for_services
    
    # Show status
    show_status
    
    # Show access information
    show_access_info
}

# Wait for services to be healthy
wait_for_services() {
    print_step "Waiting for services to be ready..."
    
    local max_attempts=60
    local attempt=0
    
    # Wait for database
    while [ $attempt -lt $max_attempts ]; do
        attempt=$((attempt + 1))
        
        if docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME exec -T db pg_isready -U postgres > /dev/null 2>&1; then
            print_status "Database is ready"
            break
        fi
        
        if [ $attempt -eq $max_attempts ]; then
            print_error "Database failed to start within expected time"
            exit 1
        fi
        
        echo -n "."
        sleep 2
    done
    
    # Wait for API
    print_step "Waiting for API to be ready..."
    sleep 10
    
    attempt=0
    while [ $attempt -lt 30 ]; do
        attempt=$((attempt + 1))
        
        if curl -f http://localhost:8000/health > /dev/null 2>&1; then
            print_status "API is ready"
            break
        fi
        
        if [ $attempt -eq 30 ]; then
            print_warning "API health check timeout, but continuing..."
            break
        fi
        
        echo -n "."
        sleep 2
    done
    
    # Wait for frontend
    print_step "Waiting for frontend to be ready..."
    sleep 5
    
    attempt=0
    while [ $attempt -lt 20 ]; do
        attempt=$((attempt + 1))
        
        if curl -f http://localhost:4200 > /dev/null 2>&1; then
            print_status "Frontend is ready"
            break
        fi
        
        if [ $attempt -eq 20 ]; then
            print_warning "Frontend health check timeout, but continuing..."
            break
        fi
        
        echo -n "."
        sleep 3
    done
}

# Stop the system
stop_system() {
    print_header "STOPPING SMART PARKING SYSTEM"
    
    check_docker
    
    print_step "Stopping all services..."
    docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME down
    
    print_status "All services stopped"
}

# Show service status
show_status() {
    print_step "Checking service status..."
    echo ""
    
    docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME ps
    echo ""
}

# Show logs
show_logs() {
    print_header "SMART PARKING SYSTEM LOGS"
    
    check_docker
    
    print_info "Showing service logs (Press Ctrl+C to exit)"
    docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME logs -f
}

# Clean up everything
cleanup_system() {
    print_header "CLEANING UP SMART PARKING SYSTEM"
    
    check_docker
    
    print_warning "This will remove all containers, volumes, and data!"
    read -p "Are you sure? Type 'yes' to continue: " -r
    if [[ $REPLY == "yes" ]]; then
        print_step "Stopping and removing containers..."
        docker-compose -f $COMPOSE_FILE -p $PROJECT_NAME down -v --remove-orphans
        
        print_step "Cleaning up Docker system..."
        docker system prune -f
        
        print_status "System cleaned up"
    else
        print_info "Cleanup cancelled"
    fi
}

# Display access information
show_access_info() {
    print_header "🎉 SMART PARKING SYSTEM IS READY!"
    
    echo -e "${GREEN}🌐 ACCESS POINTS:${NC}"
    echo -e "   ${CYAN}Frontend (Angular):${NC}     http://localhost:4200"
    echo -e "   ${CYAN}Backend API (FastAPI):${NC}  http://localhost:8000"
    echo -e "   ${CYAN}API Documentation:${NC}      http://localhost:8000/docs"
    echo -e "   ${CYAN}Celery Monitor:${NC}         http://localhost:5555"
    echo -e "   ${CYAN}Database (PostgreSQL):${NC}  localhost:5432"
    echo -e "   ${CYAN}Redis Cache:${NC}            localhost:6379"
    
    echo -e "\n${GREEN}🔐 LOGIN CREDENTIALS:${NC}"
    echo -e "   ${CYAN}Admin:${NC}  admin@smartparking.com / AdminPassword123! (8 notifications)"
    echo -e "   ${CYAN}User:${NC}   user@smartparking.com / UserPassword123! (3 notifications)"
    
    echo -e "\n${GREEN}📊 PRODUCTION DATA:${NC}"
    echo -e "   ${CYAN}Users:${NC}         23 (3 admins, 20 regular users)"
    echo -e "   ${CYAN}Parking Lots:${NC}  7 active locations"
    echo -e "   ${CYAN}Parking Slots:${NC} 1,339 (853 car, 486 bike slots)"
    echo -e "   ${CYAN}Bookings:${NC}      97 sample bookings (13 confirmed, 31 completed)"
    echo -e "   ${CYAN}Notifications:${NC} 12 sample notifications (11 unread, 1 read)"
    echo -e "   ${CYAN}Pricing Rules:${NC} Dynamic time-based pricing"
    
    echo -e "\n${GREEN}🛠️ MANAGEMENT:${NC}"
    echo -e "   ${CYAN}View Logs:${NC}       ./smart-parking --logs"
    echo -e "   ${CYAN}Stop System:${NC}     ./smart-parking --stop"
    echo -e "   ${CYAN}Restart:${NC}         ./smart-parking --start"
    echo -e "   ${CYAN}Clean Up:${NC}        ./smart-parking --cleanup"
    
    echo -e "\n${YELLOW}📝 NOTES:${NC}"
    echo -e "   • The system uses pre-built Docker images"
    echo -e "   • Includes complete notification system with WebSocket support"
    echo -e "   • All services are connected and ready for testing"
    echo -e "   • Data persists in Docker volumes between restarts"
    
    print_header "Happy Testing! 🚀"
}

# Show help
show_help() {
    print_header "SMART PARKING SYSTEM MANAGEMENT"
    echo "Usage: $0 [COMMAND]"
    echo ""
    echo "Commands:"
    echo "  --start     Start the complete system"
    echo "  --stop      Stop all services"
    echo "  --restart   Restart the system"
    echo "  --status    Show service status"
    echo "  --logs      Show service logs"
    echo "  --cleanup   Remove all containers and data"
    echo "  --help      Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 --start     # Start the system"
    echo "  $0 --stop      # Stop the system"
    echo "  $0 --logs      # View logs"
    echo "  $0 --cleanup   # Clean everything"
    echo ""
    echo "Prerequisites:"
    echo "  • Docker and Docker Compose must be installed"
    echo "  • Images must be built first (run 'make build')"
    echo ""
}

# Handle script arguments
handle_arguments() {
    case "${1:-}" in
        "--start"|"start")
            start_system
            ;;
        "--stop"|"stop")
            stop_system
            ;;
        "--restart"|"restart")
            stop_system
            sleep 2
            start_system
            ;;
        "--status"|"status")
            print_header "SERVICE STATUS"
            check_docker
            show_status
            ;;
        "--logs"|"logs")
            show_logs
            ;;
        "--cleanup"|"cleanup")
            cleanup_system
            ;;
        "--help"|"-h"|"help")
            show_help
            ;;
        "")
            show_help
            ;;
        *)
            print_error "Unknown command: $1"
            print_info "Use '$0 --help' for usage information"
            exit 1
            ;;
    esac
}

# Main execution
main() {
    # Handle command line arguments
    handle_arguments "$@"
}

# Run main function with all arguments
main "$@"
